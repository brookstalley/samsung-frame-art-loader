# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# Values marked REQUIRED have no default: config.py raises at import if they are
# missing, naming the variable. That is deliberate — a plausible-looking default
# for ART_ROOT would write the catalogue to the wrong place and look like it had
# worked.

# REQUIRED. Root of the image tree. Both planes read it; they must agree.
# The curation catalogue lives at $ART_ROOT/catalogue.sqlite — not configurable,
# because both planes and the backup path have to agree on where it is.
#   Pi:      /home/tvpi/art
#   dev Mac: /Users/<you>/art
ART_ROOT=

# Optional. Where the curation plane serves its UI and its MCP endpoint (/mcp).
# Loopback by default: the plane is reached over the overlay network, not by
# being published on the LAN. Set the host to 0.0.0.0 only deliberately.
CURATION_HOST=127.0.0.1
CURATION_PORT=8770

# Optional. What a theme that has set no pace of its own inherits. Carried
# forward from the 2024 plane, which runs the wall at three minutes on shuffle.
# A theme can override both; null on a theme means "use these".
ROTATION_INTERVAL_SECONDS=180
ROTATION_SHUFFLE=true

# Optional. The TELEVISION's panel — never the e-paper one, which belongs to the
# display plane. Curation needs it because the mat is specified in physical
# units and the resolution floor is a minimum size on the wall, so both are
# wrong on a panel of a different size. Defaults describe the reference 42" 4K
# Frame; nothing in source hardcodes a panel.
TV_PANEL_WIDTH_PX=3840
TV_PANEL_HEIGHT_PX=2160
TV_PANEL_DIAGONAL_INCHES=42

# Optional. The mat, in inches on the wall — the sides and top take
# MAT_WIDTH_INCHES, and the bottom takes that times MAT_BOTTOM_WEIGHT, because a
# true-centred image reads as sitting low. Physical units so the same numbers
# mean the same thing on any panel size.
MAT_WIDTH_INCHES=2.5
MAT_BOTTOM_WEIGHT=1.15

# Optional. The smallest a work may render along its long edge, in inches on the
# wall, before the review grid labels it as below the floor. A warning, never a
# filter: below-floor works stay visible and selectable.
RESOLUTION_FLOOR_INCHES=12

# Optional. How many works a discovery run may propose before it stops and asks.
# The gate is on the work COUNT, not on the price: real runs cost well under a
# dollar, so a money threshold gates on the axis that does not discriminate,
# while the judgement worth inviting is scope — "you asked for Dalí and I found
# 200 works — really?". A typical run finds about twenty. Zero gates every run.
DISCOVERY_APPROVAL_THRESHOLD=25

# Optional. The per-run search cap, in two parts. It exists because the monthly
# provider ceiling cannot bound a single runaway run, and because a pre-run
# estimate a run may freely exceed is not an estimate. Phase 1 gets a flat
# allowance because it has no work count to derive one from — producing the work
# count is what phase 1 is for; phase 2 gets an allowance per work it found.
# A twenty-work run is therefore bounded at 10 + 20x2 = 50 searches.
DISCOVERY_PHASE1_SEARCH_ALLOWANCE=10
DISCOVERY_PHASE2_SEARCHES_PER_WORK=2

# Optional. What the provider charges, in US dollars. RE-VERIFY THESE BEFORE
# RELYING ON THEM: model and search pricing moves fast — one recorded model price
# drifted 28% in twelve days, while another was unchanged to the cent over the
# same period. Search is routed through the model provider's own web plugin, so
# tokens and searches bill as one number under one ceiling.
#
# THE SEARCH PRICE BELONGS TO THE ENGINE ABOVE. parallel bills $0.001; exa and
# perplexity bill $0.005 for the same request. Change DISCOVERY_SEARCH_ENGINE
# without changing this and every pre-run estimate is wrong by five times — on
# the one number a curator uses to decide whether to authorise a run.
DISCOVERY_SEARCH_COST_USD=0.001
DISCOVERY_INPUT_COST_USD_PER_MTOK=0.14
DISCOVERY_OUTPUT_COST_USD_PER_MTOK=0.28

# Optional. What one phase-1 run is assumed to consume, which is what turns the
# prices above into an estimate. Wildly input-dominated, and that is the point:
# phase 1 reads injected search results and emits a short list, so the output
# price barely moves the total — and a naive in/out average would rank candidate
# models wrongly.
#
# THESE ARE FAR ABOVE WHAT A REAL RUN CONSUMES, and the gap is recorded rather
# than quietly corrected: a measured run used 3,453 input and 1,608 output tokens
# against the 490,000 assumed here, so the phase-1 estimate reads about twenty
# times the actual. The figures come from a cost analysis covering a whole run,
# while the code spends them on phase 1 alone — re-basing them needs phase 2's
# real consumption, which does not exist yet. See `nonfunctional-requirements.md`
# § Cost Constraints.
DISCOVERY_PHASE1_INPUT_TOKENS=490000
DISCOVERY_PHASE1_OUTPUT_TOKENS=30000

# Optional. Which model phase 1 asks. A floating alias rather than a dated
# snapshot, so a snapshot retirement cannot break the only paid path in the
# product; the dated pin is about a third cheaper, which against a $20 ceiling
# decides nothing.
DISCOVERY_MODEL=deepseek/deepseek-v4-flash

# Optional. The output reservation, in tokens. THIS IS A CORRECTNESS VALUE, NOT A
# TUNING KNOB: the provider prices the maximum output a request could produce and
# refuses the call outright when that reservation exceeds the credit remaining.
# Left unset the model's own maximum is reserved, so a nearly empty key refuses
# everything at full credit. Raise it only if long work lists come back truncated.
DISCOVERY_MAX_OUTPUT_TOKENS=8000

# Optional. How many pages one web search may return. Breadth is free: the fee is
# charged per search REQUEST and was measured identical at one, three, five and
# ten results, so lowering this saves nothing and sees less.
DISCOVERY_SEARCH_RESULTS=10

# Optional. Which web-search back-end to pin: exa, parallel, perplexity, native.
# CHOSEN ON COST, BECAUSE QUALITY DID NOT DISCRIMINATE. Across sixteen "resolve a
# named work to the museum that holds it" cases and a recency-bound intent, exa,
# parallel and perplexity each found the holding institution every time and
# returned the same share of in-period citations. Parallel bills $0.001 per
# request against $0.005 for the other two, so the comparison ran four times
# cheaper for identical results.
#
# Leaving this empty does NOT mean "no engine" — it resolves to the value above.
# An engine genuinely left to the provider follows the MODEL (its native search
# where it has one, Exa where it does not), which would make search a side effect
# of DISCOVERY_MODEL and let a model change silently change how the product
# searches. What was measured is phase 1's search; phase 2 retrieves image
# instances with rights and resolution, which is a different task and may well
# separate these engines where this did not.
DISCOVERY_SEARCH_ENGINE=parallel

# REQUIRED. Frame TV address on the LAN.
TV_ADDRESS=
# Optional. Samsung secure websocket port; the same on every installation.
TV_PORT=8002
# Optional. Where the TV pairing token is stored. Defaults to
# $ART_ROOT/token_file. Never place this inside the checkout — that is how the
# previous token came to be committed.
TV_TOKEN_FILE=

# REQUIRED. Drives sun-position brightness. Decimal degrees; south and west
# are negative.
LATITUDE=
LONGITUDE=
# REQUIRED. Human-readable place name, used for timezone-aware sun calculation.
LOCATION_NAME=
# Optional. Region/country, cosmetic.
LOCATION_REGION=

# OpenAI API key, used by ai.py for artwork colour/metadata inference.
OPENAI_KEY=

# OpenRouter API key. Everything the product pays for goes through this one
# account — discovery's model calls and its web searches both bill as OpenRouter
# credits, which is why one ceiling covers both.
#
# THE SPEND CEILING IS THIS KEY'S SETTING, NOT APPLICATION CODE. Set a per-key
# credit limit of USD 20 with a monthly reset in the OpenRouter console. Nothing
# in this repository enforces a cap, deliberately: a local tally that fails open
# is indistinguishable from one that works — no error, no alert, just a bill.
# The provider refusing the call with 403 "Key limit exceeded" is the whole
# mechanism. (Not 402 — that is a different refusal that arrives with credit
# still in the account, meaning the request reserved more output than the balance
# covers. Treating it as exhaustion would halt runs that can still pay.)
#
# Discovery refuses to START a run when this is unset, and says so; every other
# art_discovery action keeps working on runs that already exist. Also read by the
# model-driven evaluation suite (`-m llm_eval`) and the live API re-verification
# suite (`-m live_api`), both of which skip when it is unset.
OPENROUTER_API_KEY=

# Optional, and only for the live suite. A second key deliberately burned to its
# credit limit and kept there, so `-m live_api` can drive a real 403 and prove
# the ceiling fails closed rather than assuming it. Tests needing it skip when it
# is unset.
OPENROUTER_EXHAUSTED_KEY=

# How this deployment identifies itself to the museum APIs discovery phase 2
# asks. The Art Institute of Chicago's API is open — no key, no account, no
# quota to negotiate — but it asks callers to name themselves and give a contact
# address, e.g. "samsung-frame-art-loader (you@example.org)".
#
# There is deliberately no default, and leaving it unset switches phase 2 off:
# sending a made-up identifier would misrepresent whoever runs this to a third
# party. A run then settles its work list and stays at `resolving_images`, and
# `status` says so in words rather than appearing to work.
#
# Phase 2 spends nothing. The museum APIs are unmetered, and whether a result is
# the work that was asked for is decided locally by comparing titles and artists
# — never by the provider's relevance score, which was measured non-comparable
# between queries and comfortably non-zero for a painting the collection does not
# hold (.prawduct/artifacts/artic-api-findings.md).
ARTIC_USER_AGENT=

# omni-epd display identifier consumed by display.py, e.g. omni_epd.mock
# for development on a machine with no e-paper hardware attached.
EPD_TYPE=

# Optional. Set to false to skip e-paper label rendering (default true).
USE_ART_LABEL=
