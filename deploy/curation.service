# The curation plane: catalogue, discovery, acquisition, the browser UI and MCP.
#
# Install to /etc/systemd/system/curation.service. See deploy/README.md for the
# cutover, which creates the `tvpi` account this unit runs as.

[Unit]
Description=Samsung Frame art wall — curation plane
Documentation=file:///opt/samsung-frame-art-loader/deploy/README.md

# Same reasoning as the display unit: the stock five-starts-in-ten-seconds limit
# turns a reproducible fault into a unit that gives up after five log lines.
# Paired with RestartSec= below, which is what makes "retry forever" safe.
StartLimitIntervalSec=0

# No ordering dependency on the display plane, in either direction. Neither
# requires the other to start.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tvpi
Group=tvpi

WorkingDirectory=/opt/samsung-frame-art-loader/curation

# Un-prefixed, for the reason spelled out in display.service: a missing
# environment file must refuse to start rather than fail at import.
EnvironmentFile=/opt/samsung-frame-art-loader/.env

# Absolute for the reason spelled out in display.service: uv is system-owned and
# shared by both planes rather than installed per-account, and a named binary
# fails where it is written instead of resolving off an inherited PATH.
ExecStart=/usr/local/bin/uv run python -m curation

# **`on-failure`, not `always`, and the difference is deliberate.** This plane's
# downtime is not visible on the wall: the display plane goes on rotating the
# last manifest for as long as it takes, which is the availability norm working
# rather than degradation. A clean exit here is somebody stopping it on purpose,
# and it should stay stopped.
Restart=on-failure
RestartSec=5

# **SIGTERM is how this plane is meant to end, so it is not a failure.** uvicorn
# handles the signal, shuts the server down cleanly — the journal carries
# "Application shutdown complete" — and the process then exits 128+15. Without
# this line systemd reads 143 as a fault and leaves the unit `failed` after every
# deliberate stop, which is the state a real fault would show in: an operator who
# sees `failed` after every `systemctl stop` learns to ignore it, and the next
# genuine crash looks exactly like the last six clean stops.
#
# **The display plane needs no such line**, and the asymmetry is worth knowing
# rather than copying: it installs its own SIGTERM handler and exits 0, because it
# has a television connection to close on the way out. This plane hands signal
# handling to uvicorn and has nothing of its own to unwind.
# **Both forms, because they are different events.** `143` matches a process that
# exited with that status; `SIGTERM` matches one that died *of* the signal without
# handling it. uvicorn does the first today, and a future revision — or a shutdown
# that hangs past the stop timeout — produces the second. Matching only the exit
# code would leave the unit `failed` again, which is the exact state this line was
# added to stop appearing after a clean stop.
SuccessExitStatus=143 SIGTERM

# **The one non-obvious setting in this file, and it exists because of
# co-location.** A runaway acquisition — a genuine gigapixel scan is 20–40x the
# measured corpus maximum — must not be able to invoke the OOM killer against
# the display plane sharing this box. Capping this plane converts a shared-fate
# failure into a contained one, which is most of what the process split buys on
# a single machine: curation dies, the wall keeps turning, and the journal says
# which happened.
MemoryMax=2G

# Nothing here talks to the television or the panel, so there is no half-open
# hardware channel to protect on the way out and systemd's default stop timeout
# is left alone.

StandardOutput=journal
StandardError=journal
SyslogIdentifier=curation

[Install]
WantedBy=multi-user.target
